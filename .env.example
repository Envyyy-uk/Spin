# Copy to .env.local and fill in to connect real data. Only EXPO_PUBLIC_* values
# are bundled into the app, and they are PUBLIC — never put provider API keys
# here. Point these at your own backend, which keeps the keys server-side.

# POST {url}/suggestions  -> { groups: { stay: Card[], activities: Card[], places: Card[] } }
EXPO_PUBLIC_SUGGESTIONS_API_URL=

# Reserved for a future live pricing backend (see src/services/pricingService.js).
EXPO_PUBLIC_PRICING_API_URL=

# Optional Booking.com affiliate id appended to accommodation search links.
EXPO_PUBLIC_BOOKING_AID=
